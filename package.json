{
  "name": "marketplace-ledger-engine",
  "version": "1.0.0",
  "description": "Fault-tolerant double-entry accounting and multi-split fund distribution engine for marketplaces, platforms, and fintechs.",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "test": "jest",
    "prepublishOnly": "npm run test && npm run build"
  },
  "keywords": [
    "ledger",
    "double-entry",
    "accounting",
    "marketplace",
    "fintech",
    "payment-splits",
    "fund-distribution",
    "commissions",
    "escrow"
  ],
  "author": "Peter Chukwu",
  "license": "MIT",
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2"
  }
}
